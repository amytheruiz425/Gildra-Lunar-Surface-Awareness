       PROCEDURE DIVISION.

           OPEN OUTPUT TELEMETRY-FILE.

                      MOVE "ROVER=GILDRA-LR01"
               TO TELEMETRY-RECORD
           WRITE TELEMETRY-RECORD.

           MOVE "BATTERY=038"
               TO TELEMETRY-RECORD
           WRITE TELEMETRY-RECORD.

           MOVE "MOTOR_TEMP=067"
               TO TELEMETRY-RECORD
           WRITE TELEMETRY-RECORD.

           MOVE "WHEEL_SLIP=029"
               TO TELEMETRY-RECORD
           WRITE TELEMETRY-RECORD.

           MOVE "TERRAIN_SLOPE=022.0"
               TO TELEMETRY-RECORD
           WRITE TELEMETRY-RECORD.

           MOVE "SIGNAL=046"
               TO TELEMETRY-RECORD
           WRITE TELEMETRY-RECORD.

           MOVE "SPEED=0.08"
               TO TELEMETRY-RECORD
           WRITE TELEMETRY-RECORD.
           CLOSE TELEMETRY-FILE.

           DISPLAY "LUNAR TELEMETRY GENERATED".
           DISPLAY "ROVER: GILDRA-LR01".

           STOP RUN.
